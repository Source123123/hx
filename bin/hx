#!/bin/sh
# 插件自带的启动器：不需要 pip install，直接用仓库里的源码运行。
root="$(cd "$(dirname "$0")/.." && pwd)"
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m hx "$@"
  fi
done
echo "hx 需要 Python 3.9 或更高版本，但没有找到 python3。请先安装 Python：https://www.python.org/downloads/" >&2
exit 127
